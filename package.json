{
  "name": "mon-devis",
  "version": "1.0.0",
  "private": true,
  "description": "MON DEVIS — Plateforme SaaS de création, gestion, suivi et export de devis professionnels.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:start": "node scripts/start-db.mjs",
    "db:stop": "node scripts/stop-db.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "setup": "node scripts/setup.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:prod": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/nodemailer": "^8.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.6.0",
    "docx": "^9.11.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.499.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.90.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "svg-to-pdfkit": "^0.1.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
