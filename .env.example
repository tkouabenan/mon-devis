# ---------------------------------------------------------------------------
# MON DEVIS — variables d'environnement
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL (obligatoire)
# ⚠️ Ce fichier est un MODÈLE publié dans le dépôt : n'y mettez JAMAIS un vrai
#    mot de passe. Les valeurs réelles vont dans `.env` (non suivi par git).
#
# Développement local (base embarquée démarrée par `npm run db:start`) :
DATABASE_URL="postgresql://mondevis:mondevis@127.0.0.1:54329/mon_devis?schema=public"
#
# Supabase — remplacez <ref>, <region> et <mot-de-passe> (Tableau de bord →
# Project Settings → Database → Connection string, onglet « URI ») :
#   · pooler de SESSION (port 5432) pour les migrations :
#     DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#   · pooler de TRANSACTIONS (port 6543, utilisateur `postgres.<ref>-pooler`)
#     pour l'application sur Vercel :
#     DATABASE_URL="postgresql://postgres.<ref>-pooler:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
#   Un mot de passe contenant un caractère spécial doit être encodé
#   (@ → %40, espace → %20, # → %23) : une URL non encodée échoue à la connexion.

# Base utilisée par les tests d'intégration (jamais la base de développement)
TEST_DATABASE_URL="postgresql://mondevis:mondevis@127.0.0.1:54329/mon_devis_test?schema=public"

# Secret de signature des sessions (obligatoire en production, 32+ caractères)
# Générer : openssl rand -base64 48
AUTH_SECRET="changez-moi-avec-un-secret-aleatoire-de-32-caracteres-minimum"

# URL publique de l'application (utilisée pour les liens de partage / e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="MON DEVIS"

# --- Stockage des fichiers (logos, exports) ---------------------------------
# local | s3
STORAGE_DRIVER="local"
# Répertoire de stockage local (par défaut : <racine du projet>/var/uploads)
STORAGE_LOCAL_DIR="./var/uploads"
# Fournisseur S3 compatible (AWS S3, Cloudflare R2, Supabase Storage, MinIO…)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Livraison d'e-mails ----------------------------------------------------
# console | smtp | resend | postmark
# En mode "console", aucun e-mail réel n'est envoyé : les messages sont
# enregistrés en base et tracés dans les logs (développement uniquement).
EMAIL_DRIVER="console"
EMAIL_FROM="MON DEVIS <no-reply@mon-devis.app>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""

# --- Paiements (désactivés tant qu'aucune clé n'est fournie) ----------------
# stripe | cinetpay | paystack | none
PAYMENT_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
PAYSTACK_SECRET_KEY=""

# --- Messagerie mobile (Orange Money, MTN MoMo, Wave) ----------------------
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
WAVE_API_KEY=""

# --- Hôtes de développement autorisés (preview, tunnels) -------------------
# Liste séparée par des virgules. `*` autorise tous les sous-domaines.
ALLOWED_DEV_ORIGINS="*.e2b.app,localhost,127.0.0.1"

# --- Divers -----------------------------------------------------------------
# Clé de hachage des adresses IP pour l'audit (RGPD). Générer un secret dédié.
IP_HASH_SALT="mon-devis-local-salt"
# Limitation de débit : fenêtre (secondes) et quota global par IP
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"
